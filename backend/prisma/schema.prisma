// backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  PLAYER
  SUPPORT
  MODERATOR
  ADMIN
}

model Account {
  id              Int             @id @default(autoincrement())
  email           String          @unique
  password        String
  // Legado: não é mais usado. O acesso Premium vem de PremiumPeriod.
  vipDays         Int             @default(0)
  role            AccountRole     @default(PLAYER)
  emailVerifiedAt DateTime?
  createdAt       DateTime        @default(now())
  characters      Character[]
  sessions        Session[]
  tokens          AccountToken[]
  punishments     Punishment[]
  premiumPeriods  PremiumPeriod[]
  premiumOrders   PremiumOrder[]
  tickets         SupportTicket[]
}

model Session {
  tokenHash String   @id @db.VarChar(64)
  accountId Int
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([expiresAt])
}

model Operation {
  key         String   @id @db.VarChar(160)
  fingerprint String   @db.VarChar(64)
  result      Json
  createdAt   DateTime @default(now())
}

enum Vocation {
  NONE
  KNIGHT
  ELITE_KNIGHT
  PALADIN
  ROYAL_PALADIN
  SORCERER
  MASTER_SORCERER
  DRUID
  ELDER_DRUID
}

enum ItemSlot {
  AMULET
  HELMET
  BACKPACK
  WEAPON
  ARMOR
  SHIELD
  RING
  LEGS
  AMMO
  BOOTS
  CONSUMABLE
  LOOT
}

model Character {
  id                     Int                    @id @default(autoincrement())
  accountId              Int
  account                Account                @relation(fields: [accountId], references: [id])
  name                   String                 @unique
  vocation               Vocation               @default(NONE)
  vocationChosen         Boolean                @default(false)
  journeyStep            Int                    @default(0)
  level                  Int                    @default(1)
  experience             BigInt                 @default(0)
  hp                     Int                    @default(150)
  maxHp                  Int                    @default(150)
  mana                   Int                    @default(55)
  maxMana                Int                    @default(55)
  energy                 Int                    @default(100)
  maxEnergy              Int                    @default(100)
  templeReadyAt          DateTime?
  strength               Int                    @default(10)
  vitality               Int                    @default(10)
  agility                Int                    @default(10)
  resistance             Int                    @default(10)
  statPoints             Int                    @default(0)
  goldInHand             BigInt                 @default(100)
  goldInBank             BigInt                 @default(0)
  huntMonsterId          Int?
  huntEndsAt             DateTime?
  guildId                Int?
  guild                  Guild?                 @relation(fields: [guildId], references: [id])
  guildRank              String                 @default("MEMBER")
  pvpWins                Int                    @default(0)
  pvpLosses              Int                    @default(0)
  promotedAt             DateTime?
  classTier              Int                    @default(0)
  profileAvatar          String?                @db.VarChar(60)
  profileAbout           String?                @db.Text
  profileHideVisits      Boolean                @default(false)
  scrapsReceived         ProfileScrap[]         @relation("ScrapsReceived")
  scrapsWritten          ProfileScrap[]         @relation("ScrapsWritten")
  testimonialsReceived   ProfileTestimonial[]   @relation("TestimonialsReceived")
  testimonialsWritten    ProfileTestimonial[]   @relation("TestimonialsWritten")
  friendRequestsSent     Friendship[]           @relation("FriendRequester")
  friendRequestsReceived Friendship[]           @relation("FriendAddressee")
  profileVisits          ProfileVisit[]         @relation("ProfileVisited")
  visitsMade             ProfileVisit[]         @relation("ProfileVisitor")
  forumPosts             ForumPost[]
  forumComments          ForumComment[]
  forumVotes             ForumVote[]
  partiesLed             HuntParty[]            @relation("PartyLeader")
  partyMemberships       HuntPartyMember[]
  groupFights            GroupBattleFighter[]
  profileTitle           String?                @db.VarChar(24)
  profileEmblem          String?                @db.VarChar(40)
  profileBio             String?                @db.VarChar(160)
  fameHidden             Boolean                @default(false)
  rareItemsMade          RareItem[]
  profileFrame           String?                @db.VarChar(16)
  presets                CharacterPreset[]
  goldLedger             GoldLedger[]
  itemLedger             ItemLedger[]
  inventory              InventoryItem[]
  battles                Battle[]
  marketListings         MarketListing[]
  tasks                  CharacterTask[]
  quests                 CharacterQuest[]
  events                 AdventureEvent[]
  achievements           CharacterAchievement[]
}

model ItemBlueprint {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  tibiaWikiId    String?
  slot           ItemSlot
  spriteUrl      String
  attack         Int              @default(0)
  defense        Int              @default(0)
  armor          Int              @default(0)
  minLevel       Int              @default(1)
  vocations      String           @default("ALL")
  npcPrice       Int              @default(50)
  magicAttack    Int              @default(0)
  criticalChance Int              @default(0)
  fireResistance Int              @default(0)
  speed          Int              @default(0)
  inventoryItems InventoryItem[]
  monsterLoots   MonsterLoot[]
  marketListings MarketListing[]
  questRewards   QuestBlueprint[]
  rareItems      RareItem[]
}

model InventoryItem {
  id           Int           @id @default(autoincrement())
  characterId  Int
  character    Character     @relation(fields: [characterId], references: [id])
  blueprintId  Int
  blueprint    ItemBlueprint @relation(fields: [blueprintId], references: [id])
  quantity     Int           @default(1)
  isEquipped   Boolean       @default(false)
  equippedSlot ItemSlot?
  upgradeTier  Int           @default(0)
  favorite     Boolean       @default(false)
  rareItemId   Int?          @unique
  rareItem     RareItem?     @relation(fields: [rareItemId], references: [id])

  @@unique([characterId, equippedSlot])
}

model Monster {
  id         Int              @id @default(autoincrement())
  name       String           @unique
  level      Int              @default(1)
  hp         Int
  experience Int
  attack     Int
  defense    Int
  spriteUrl  String
  goldMin    Int              @default(0)
  goldMax    Int              @default(10)
  regionKey  String           @default("outskirts")
  isBoss     Boolean          @default(false)
  element    String           @default("PHYSICAL")
  loots      MonsterLoot[]
  battles    Battle[]
  tasks      TaskBlueprint[]
  quests     QuestBlueprint[]
}

model MonsterLoot {
  id          Int           @id @default(autoincrement())
  monsterId   Int
  monster     Monster       @relation(fields: [monsterId], references: [id])
  blueprintId Int
  blueprint   ItemBlueprint @relation(fields: [blueprintId], references: [id])
  dropChance  Float
  maxAmount   Int           @default(1)

  @@unique([monsterId, blueprintId])
}

model Battle {
  id                Int       @id @default(autoincrement())
  characterId       Int
  character         Character @relation(fields: [characterId], references: [id])
  monsterId         Int
  monster           Monster   @relation(fields: [monsterId], references: [id])
  activeCharacterId Int?      @unique
  turnVersion       Int       @default(0)
  monsterHp         Int
  isFinished        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  outcome           String    @default("ONGOING")
  lastLog           Json?
  rewardGold        BigInt    @default(0)
  rewardExperience  Int       @default(0)
  rewardRecorded    Boolean   @default(false)

  @@index([characterId, isFinished])
}

model MarketListing {
  id          Int           @id @default(autoincrement())
  sellerId    Int
  seller      Character     @relation(fields: [sellerId], references: [id])
  blueprintId Int
  blueprint   ItemBlueprint @relation(fields: [blueprintId], references: [id])
  quantity    Int           @default(1)
  upgradeTier Int           @default(0)
  rareItemId  Int?
  rareItem    RareItem?     @relation(fields: [rareItemId], references: [id])
  price       BigInt
  status      String        @default("OPEN")
  buyerId     Int?
  createdAt   DateTime      @default(now())
  expiresAt   DateTime?
  soldAt      DateTime?
  fee         BigInt        @default(0)
  listingFee  BigInt        @default(0)

  @@index([status, id])
  @@index([status, expiresAt])
}

model TaskBlueprint {
  id            Int             @id @default(autoincrement())
  title         String          @unique
  monsterId     Int
  monster       Monster         @relation(fields: [monsterId], references: [id])
  requiredKills Int
  minLevel      Int             @default(1)
  rewardExp     Int
  rewardGold    Int
  rewardItemId  Int?
  bossMonsterId Int?
  playerTasks   CharacterTask[]
}

model CharacterTask {
  id           Int           @id @default(autoincrement())
  characterId  Int
  character    Character     @relation(fields: [characterId], references: [id])
  taskId       Int
  task         TaskBlueprint @relation(fields: [taskId], references: [id])
  currentKills Int           @default(0)
  isCompleted  Boolean       @default(false)

  @@unique([characterId, taskId])
}

model QuestBlueprint {
  id            Int              @id @default(autoincrement())
  name          String           @unique
  description   String
  minLevel      Int
  isDungeon     Boolean          @default(false)
  bossMonsterId Int
  bossMonster   Monster          @relation(fields: [bossMonsterId], references: [id])
  rewardExp     Int
  rewardGold    Int
  rewardItemId  Int
  rewardItem    ItemBlueprint    @relation(fields: [rewardItemId], references: [id])
  completions   CharacterQuest[]
}

model CharacterQuest {
  id          Int            @id @default(autoincrement())
  characterId Int
  character   Character      @relation(fields: [characterId], references: [id])
  questId     Int
  quest       QuestBlueprint @relation(fields: [questId], references: [id])
  completedAt DateTime       @default(now())

  @@unique([characterId, questId])
}

model Guild {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  tag         String      @unique
  description String      @default("Uma guilda tibiana.")
  leaderId    Int
  treasury    BigInt      @default(0)
  level       Int         @default(1)
  wins        Int         @default(0)
  losses      Int         @default(0)
  members     Character[]
  createdAt   DateTime    @default(now())
}

model KingdomState {
  id            Int       @id @default(1)
  kingId        Int?
  taxRate       Float     @default(0.05)
  coffers       BigInt    @default(10000)
  gatesOpen     Boolean   @default(false)
  gatesOpenedAt DateTime?
  updatedAt     DateTime  @updatedAt
}

model AdventureEvent {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  kind        String
  title       String
  description String    @db.Text
  createdAt   DateTime  @default(now())

  @@index([characterId, id])
}

model CharacterAchievement {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  key         String
  unlockedAt  DateTime  @default(now())

  @@unique([characterId, key])
}

// ===== Versão 0.5: economia, operação, Premium e pagamentos =====

model GameSetting {
  key         String   @id @db.VarChar(64)
  value       Int
  updatedAt   DateTime @updatedAt
  updatedById Int?
}

model GoldLedger {
  id           Int       @id @default(autoincrement())
  characterId  Int
  character    Character @relation(fields: [characterId], references: [id])
  delta        BigInt
  balanceAfter BigInt
  reason       String    @db.VarChar(32)
  refType      String?   @db.VarChar(24)
  refId        Int?
  createdAt    DateTime  @default(now())

  @@index([characterId, id])
  @@index([reason, createdAt])
  @@index([createdAt])
}

model ItemLedger {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  blueprintId Int
  delta       Int
  upgradeTier Int       @default(0)
  reason      String    @db.VarChar(32)
  refType     String?   @db.VarChar(24)
  refId       Int?
  createdAt   DateTime  @default(now())

  @@index([characterId, id])
  @@index([blueprintId, createdAt])
  @@index([reason, createdAt])
}

model AccountToken {
  tokenHash String    @id @db.VarChar(64)
  accountId Int
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind      String    @db.VarChar(16)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId, kind])
  @@index([expiresAt])
}

model Punishment {
  id           Int       @id @default(autoincrement())
  accountId    Int
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind         String    @db.VarChar(12)
  reason       String    @db.VarChar(500)
  createdById  Int
  startsAt     DateTime  @default(now())
  expiresAt    DateTime?
  revokedAt    DateTime?
  revokedById  Int?
  revokeReason String?   @db.VarChar(500)

  @@index([accountId, kind])
}

model AdminAuditLog {
  id             Int      @id @default(autoincrement())
  actorAccountId Int
  action         String   @db.VarChar(40)
  targetType     String   @db.VarChar(24)
  targetId       Int?
  reason         String   @db.VarChar(500)
  details        Json?
  createdAt      DateTime @default(now())

  @@index([actorAccountId, id])
  @@index([targetType, targetId])
}

model SupportTicket {
  id                  Int              @id @default(autoincrement())
  accountId           Int
  account             Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind                String           @default("SUPPORT") @db.VarChar(12)
  reportedCharacterId Int?
  subject             String           @db.VarChar(120)
  status              String           @default("OPEN") @db.VarChar(12)
  assignedToId        Int?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  messages            SupportMessage[]

  @@index([status, id])
  @@index([accountId, id])
}

model SupportMessage {
  id              Int           @id @default(autoincrement())
  ticketId        Int
  ticket          SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorAccountId Int
  body            String        @db.Text
  internal        Boolean       @default(false)
  createdAt       DateTime      @default(now())

  @@index([ticketId, id])
}

model PremiumOrder {
  id                   Int            @id @default(autoincrement())
  accountId            Int
  account              Account        @relation(fields: [accountId], references: [id])
  status               String         @default("PENDING") @db.VarChar(12)
  amountCents          Int
  currency             String         @default("BRL") @db.VarChar(3)
  days                 Int
  provider             String         @default("MERCADOPAGO") @db.VarChar(16)
  providerPreferenceId String?        @db.VarChar(80)
  providerPaymentId    String?        @unique @db.VarChar(40)
  checkoutUrl          String?        @db.VarChar(500)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  paidAt               DateTime?
  refundedAt           DateTime?
  period               PremiumPeriod?

  @@index([accountId, id])
  @@index([status, createdAt])
}

model PremiumPeriod {
  id           Int           @id @default(autoincrement())
  accountId    Int
  account      Account       @relation(fields: [accountId], references: [id])
  source       String        @db.VarChar(12)
  orderId      Int?          @unique
  order        PremiumOrder? @relation(fields: [orderId], references: [id])
  days         Int
  startsAt     DateTime
  endsAt       DateTime
  reason       String?       @db.VarChar(500)
  createdById  Int?
  createdAt    DateTime      @default(now())
  revokedAt    DateTime?
  revokedById  Int?
  revokeReason String?       @db.VarChar(500)

  @@index([accountId, endsAt])
}

model PaymentEvent {
  id        Int      @id @default(autoincrement())
  provider  String   @db.VarChar(16)
  eventKey  String   @unique @db.VarChar(120)
  payload   Json
  createdAt DateTime @default(now())
}

model CharacterPreset {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(30)
  itemIds     Json
  createdAt   DateTime  @default(now())

  @@unique([characterId, name])
}

// Item raro = equipamento que chegou ao +10. Ganha número exclusivo (por tipo de item) e uma história que sobrevive à destruição do item.
model RareItem {
  id            Int             @id @default(autoincrement())
  blueprintId   Int
  blueprint     ItemBlueprint   @relation(fields: [blueprintId], references: [id])
  serial        Int
  creatorId     Int?
  creator       Character?      @relation(fields: [creatorId], references: [id])
  firstOfKind   Boolean         @default(false)
  status        String          @default("CIRCULATING")
  createdAt     DateTime        @default(now())
  retiredAt     DateTime?
  retiredReason String?         @db.VarChar(40)
  inventoryItem InventoryItem?
  listings      MarketListing[]
  events        RareItemEvent[]

  @@unique([blueprintId, serial])
  @@index([status])
}

model RareItemEvent {
  id         Int      @id @default(autoincrement())
  rareItemId Int
  rareItem   RareItem @relation(fields: [rareItemId], references: [id])
  kind       String   @db.VarChar(24)
  detail     String   @db.VarChar(200)
  createdAt  DateTime @default(now())

  @@index([rareItemId])
}

// ----- Comunidade (perfil): recados, depoimentos, amizades e visitas -----
model ProfileScrap {
  id          Int       @id @default(autoincrement())
  profileId   Int
  profile     Character @relation("ScrapsReceived", fields: [profileId], references: [id], onDelete: Cascade)
  authorId    Int
  author      Character @relation("ScrapsWritten", fields: [authorId], references: [id], onDelete: Cascade)
  text        String    @db.VarChar(500)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  deletedById Int?

  @@index([profileId, id])
  @@index([authorId, createdAt])
}

model ProfileTestimonial {
  id        Int       @id @default(autoincrement())
  profileId Int
  profile   Character @relation("TestimonialsReceived", fields: [profileId], references: [id], onDelete: Cascade)
  authorId  Int
  author    Character @relation("TestimonialsWritten", fields: [authorId], references: [id], onDelete: Cascade)
  text      String    @db.VarChar(1000)
  status    String    @default("PENDING") @db.VarChar(12)
  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@unique([profileId, authorId])
  @@index([profileId, status])
}

model Friendship {
  id          Int       @id @default(autoincrement())
  requesterId Int
  requester   Character @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId Int
  addressee   Character @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String    @default("PENDING") @db.VarChar(12)
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model ProfileVisit {
  id        Int       @id @default(autoincrement())
  profileId Int
  profile   Character @relation("ProfileVisited", fields: [profileId], references: [id], onDelete: Cascade)
  visitorId Int
  visitor   Character @relation("ProfileVisitor", fields: [visitorId], references: [id], onDelete: Cascade)
  visitedAt DateTime  @default(now())

  @@unique([profileId, visitorId])
  @@index([profileId, visitedAt])
}

// ----- Fórum (estilo Reddit): tópicos por categoria, comentários com respostas e votos -----
model ForumPost {
  id              Int            @id @default(autoincrement())
  category        String         @db.VarChar(16)
  authorId        Int
  author          Character      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title           String         @db.VarChar(120)
  body            String         @db.Text
  score           Int            @default(0)
  commentCount    Int            @default(0)
  solvedCommentId Int?
  pinned          Boolean        @default(false)
  locked          Boolean        @default(false)
  createdAt       DateTime       @default(now())
  lastActivityAt  DateTime       @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?
  comments        ForumComment[]
  votes           ForumVote[]

  @@index([category, lastActivityAt])
  @@index([lastActivityAt])
  @@index([score])
  @@index([authorId, createdAt])
}

model ForumComment {
  id        Int         @id @default(autoincrement())
  postId    Int
  post      ForumPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  Int
  author    Character   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  Int?
  body      String      @db.Text
  score     Int         @default(0)
  createdAt DateTime    @default(now())
  deletedAt DateTime?
  votes     ForumVote[]

  @@index([postId, id])
  @@index([authorId, createdAt])
}

model ForumVote {
  id          Int           @id @default(autoincrement())
  characterId Int
  character   Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  postId      Int?
  post        ForumPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId   Int?
  comment     ForumComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  value       Int

  @@unique([characterId, postId])
  @@unique([characterId, commentId])
}

// Caçada em grupo (A Caçada das Quatro Marcas). Grupo de 2 a 4 amigos; batalha em rodadas com prazo.
model HuntParty {
  id        Int               @id @default(autoincrement())
  leaderId  Int
  leader    Character         @relation("PartyLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  huntKey   String            @db.VarChar(32)
  status    String            @default("FORMING") @db.VarChar(12) // FORMING | FIGHTING | CLOSED
  createdAt DateTime          @default(now())
  members   HuntPartyMember[]
  battles   GroupBattle[]

  @@index([leaderId, status])
}

model HuntPartyMember {
  id                Int       @id @default(autoincrement())
  partyId           Int
  party             HuntParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  characterId       Int
  character         Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  status            String    @default("INVITED") @db.VarChar(12) // INVITED | JOINED
  // Preenchido enquanto o personagem está num grupo aberto: garante um grupo por vez.
  activeCharacterId Int?      @unique
  createdAt         DateTime  @default(now())

  @@unique([partyId, characterId])
  @@index([characterId, status])
}

model GroupBattle {
  id         Int                  @id @default(autoincrement())
  partyId    Int
  party      HuntParty            @relation(fields: [partyId], references: [id], onDelete: Cascade)
  huntKey    String               @db.VarChar(32)
  round      Int                  @default(1)
  bossHp     Int
  bossMaxHp  Int
  state      Json
  deadlineAt DateTime
  isFinished Boolean              @default(false)
  outcome    String               @default("ONGOING") @db.VarChar(12)
  log        Json?
  createdAt  DateTime             @default(now())
  fighters   GroupBattleFighter[]

  @@index([huntKey, isFinished])
}

model GroupBattleFighter {
  id                Int         @id @default(autoincrement())
  battleId          Int
  battle            GroupBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  characterId       Int
  character         Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  vocation          String      @db.VarChar(16)
  hp                Int
  maxHp             Int
  mana              Int
  maxMana           Int
  action            String?     @db.VarChar(16)
  // Preenchido enquanto a batalha está em andamento: um combate em grupo por vez.
  activeCharacterId Int?        @unique
  rewardGold        BigInt      @default(0)
  rewardExperience  Int         @default(0)
  rewarded          Boolean     @default(false)

  @@unique([battleId, characterId])
  @@index([characterId, rewarded])
}

// Avisos da equipe para todos os jogadores (manutenção, eventos). Aparecem também na tela de entrada.
model GameNotice {
  id          Int       @id @default(autoincrement())
  kind        String    @default("INFO") @db.VarChar(12) // INFO | MAINTENANCE
  message     String    @db.VarChar(300)
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  endedAt     DateTime?
  createdById Int
  createdAt   DateTime  @default(now())

  @@index([endedAt, startsAt])
}
